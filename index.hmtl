<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PetShop Amigo Fiel</title>
    <style>
        /* Estilos Globais */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f4f7f6;
            color: #333;
        }

        /* Cabeçalho */
        header {
            background-color: #4CAF50;
            color: white;
            padding: 20px;
            text-align: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        header h1 {
            margin-bottom: 10px;
        }

        /* Barra de Pesquisa */
        .search-container {
            margin: 15px auto;
            max-width: 500px;
            width: 90%;
        }

        .search-container input {
            width: 100%;
            padding: 12px 20px;
            font-size: 16px;
            border: 2px solid #ddd;
            border-radius: 25px;
            outline: none;
            transition: border-color 0.3s;
        }

        .search-container input:focus {
            border-color: #4CAF50;
        }

        /* Grade de Produtos */
        .container {
            max-width: 1100px;
            margin: 20px auto;
            padding: 0 20px;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }

        /* Cartão de Produto */
        .product-card {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: transform 0.2s;
            display: flex;
            flex-direction: column;
        }

        .product-card:hover {
            transform: translateY(-5px);
        }

        .product-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .product-info {
            padding: 15px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .product-title {
            font-size: 1.1em;
            margin-bottom: 8px;
            color: #2c3e50;
        }

        .product-price {
            font-size: 1.2em;
            color: #4CAF50;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .btn-buy {
            margin-top: auto;
            background-color: #ff9800;
            color: white;
            border: none;
            padding: 10px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: background-color 0.2s;
        }

        .btn-buy:hover {
            background-color: #e68a00;
        }

        /* Mensagem de "Nenhum Resultado" */
        .no-results {
            text-align: center;
            grid-column: 1 / -1;
            padding: 40px;
            color: #777;
            font-size: 1.2em;
            display: none;
        }
    </style>
</head>
<body>

    <header>
        <h1>🐾 PetShop Amigo Fiel</h1>
        <p>Tudo o que seu pet precisa em um só lugar!</p>
        
        <div class="search-container">
            <input type="text" id="searchInput" placeholder="Pesquisar ração, brinquedos, acessórios..." onkeyup="filterProducts()">
        </div>
    </header>

    <div class="container">
        <div class="products-grid" id="productsGrid">
            
            <div class="product-card">
                <img src="https://images.unsplash.com/photo-1589924691995-400dc9ecc119?w=500" alt="Ração para Cães">
                <div class="product-info">
                    <h3 class="product-title">Ração Premium para Cães (15kg)</h3>
                    <p class="product-price">R$ 149,90</p>
                    <button class="btn-buy" onclick="adicionarAoCarrinho('Ração Premium para Cães')">Comprar</button>
                </div>
            </div>

            <div class="product-card">
                <img src="https://images.unsplash.com/photo-1545249390-6bdfa286032f?w=500" alt="Arranhador para Gatos">
                <div class="product-info">
                    <h3 class="product-title">Arranhador Interativo para Gatos</h3>
                    <p class="product-price">R$ 89,90</p>
                    <button class="btn-buy" onclick="adicionarAoCarrinho('Arranhador Interativo')">Comprar</button>
                </div>
            </div>

            <div class="product-card">
                <img src="https://images.unsplash.com/photo-1535294435445-d7249524ef2e?w=500" alt="Brinquedo Osso">
                <div class="product-info">
                    <h3 class="product-title">Brinquedo Osso de Borracha</h3>
                    <p class="product-price">R$ 25,00</p>
                    <button class="btn-buy" onclick="adicionarAoCarrinho('Brinquedo Osso de Borracha')">Comprar</button>
                </div>
            </div>

            <div class="product-card">
                <img src="https://images.unsplash.com/photo-1601758228041-f3b2795255f1?w=500" alt="Coleira">
                <div class="product-info">
                    <h3 class="product-title">Coleira Ajustável com Guia</h3>
                    <p class="product-price">R$ 45,00</p>
                    <button class="btn-buy" onclick="adicionarAoCarrinho('Coleira Ajustável')">Comprar</button>
                </div>
            </div>

            <div class="product-card">
                <img src="https://images.unsplash.com/photo-1516734212186-a967f81ad0d7?w=500" alt="Cama Pet">
                <div class="product-info">
                    <h3 class="product-title">Cama Confortável Nuvem (Tamanho M)</h3>
                    <p class="product-price">R$ 119,00</p>
                    <button class="btn-buy" onclick="adicionarAoCarrinho('Cama Confortável Nuvem')">Comprar</button>
                </div>
            </div>

            <div class="product-card">
                <img src="https://images.unsplash.com/photo-1583337130417-3346a1be7dee?w=500" alt="Shampoo Pet">
                <div class="product-info">
                    <h3 class="product-title">Shampoo e Condicionador Neutro</h3>
                    <p class="product-price">R$ 32,90</p>
                    <button class="btn-buy" onclick="adicionarAoCarrinho('Shampoo Neutro')">Comprar</button>
                </div>
            </div>

            <div class="no-results" id="noResults">
                Nenhum produto encontrado com esse nome. 😿
            </div>

        </div>
    </div>

    <script>
        // Função da Barra de Pesquisa
        function filterProducts() {
            const searchInput = document.getElementById('searchInput').value.toLowerCase();
            const productCards = document.querySelectorAll('.product-card');
            let visibleCount = 0;

            productCards.forEach(card => {
                const title = card.querySelector('.product-title').innerText.toLowerCase();
                
                if (title.includes(searchInput)) {
                    card.style.display = 'flex';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // Exibir mensagem se nada for encontrado
            const noResults = document.getElementById('noResults');
            if (visibleCount === 0) {
                noResults.style.display = 'block';
            } else {
                noResults.style.display = 'none';
            }
        }

        // Função de Ação ao clicar em Comprar
        function adicionarAoCarrinho(nomeProduto) {
            alert(`Você adicionou "${nomeProduto}" ao carrinho com sucesso! 🛒`);
        }
    </script>
</body>
</html>