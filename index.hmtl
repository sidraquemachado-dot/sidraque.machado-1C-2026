<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Pet Feliz - Produtos, serviços e cuidados para seu pet.">
  <title>Pet Feliz | Pet Shop</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    :root {
      --verde: #20b486;
      --verde-escuro: #087f5b;
      --azul: #38bdf8;
      --amarelo: #ffd166;
      --vermelho: #ef476f;
      --fundo: #f6fbf9;
      --texto: #243238;
      --branco: #ffffff;
      --sombra: 0 8px 25px rgba(0,0,0,.08);
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--fundo);
      color: var(--texto);
      line-height: 1.5;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
      border: none;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* HEADER */
    header {
      background: rgba(255,255,255,.96);
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 2px 15px rgba(0,0,0,.06);
    }

    .navbar {
      max-width: 1200px;
      margin: auto;
      padding: 15px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .logo {
      font-size: 25px;
      font-weight: bold;
      color: var(--verde-escuro);
      white-space: nowrap;
    }

    .logo span {
      color: var(--azul);
    }

    nav {
      display: flex;
      gap: 20px;
    }

    nav a {
      font-weight: 600;
      color: #43545a;
      transition: .2s;
    }

    nav a:hover {
      color: var(--verde);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .cart-button {
      background: var(--verde);
      color: white;
      padding: 10px 15px;
      border-radius: 25px;
      font-weight: bold;
    }

    .cart-button:hover {
      background: var(--verde-escuro);
    }

    .hamburger {
      display: none;
      background: transparent;
      font-size: 27px;
    }

    /* HERO */
    .hero {
      max-width: 1200px;
      margin: 25px auto;
      padding: 70px 40px;
      border-radius: 25px;
      background: linear-gradient(135deg, #dff9ef, #e5f7ff);
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      align-items: center;
      gap: 40px;
      overflow: hidden;
    }

    .hero h1 {
      font-size: clamp(35px, 5vw, 58px);
      line-height: 1.05;
      margin-bottom: 20px;
      color: #123d35;
    }

    .hero p {
      font-size: 19px;
      color: #52666b;
      margin-bottom: 25px;
    }

    .hero-image {
      font-size: 180px;
      text-align: center;
      filter: drop-shadow(0 15px 15px rgba(0,0,0,.1));
    }

    .buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .btn {
      padding: 13px 20px;
      border-radius: 12px;
      font-weight: bold;
      transition: .2s;
      display: inline-block;
    }

    .btn-primary {
      background: var(--verde);
      color: white;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      background: var(--verde-escuro);
    }

    .btn-secondary {
      background: white;
      color: var(--verde-escuro);
    }

    .btn-secondary:hover {
      background: #f0fffa;
    }

    /* PESQUISA */
    .search-area {
      max-width: 1000px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .search-box {
      background: white;
      box-shadow: var(--sombra);
      border-radius: 18px;
      padding: 20px;
    }

    .search-box h2 {
      margin-bottom: 12px;
    }

    .search-input {
      width: 100%;
      border: 2px solid #e3eeee;
      border-radius: 12px;
      padding: 15px 18px;
      outline: none;
      transition: .2s;
    }

    .search-input:focus {
      border-color: var(--verde);
    }

    .search-suggestions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
    }

    .suggestion {
      background: #e9f9f3;
      color: var(--verde-escuro);
      border-radius: 20px;
      padding: 7px 12px;
      cursor: pointer;
      font-size: 14px;
    }

    /* SEÇÕES */
    section {
      max-width: 1200px;
      margin: 70px auto;
      padding: 0 20px;
    }

    .section-title {
      text-align: center;
      margin-bottom: 30px;
    }

    .section-title h2 {
      font-size: 34px;
      color: #183d36;
    }

    .section-title p {
      color: #66777b;
      margin-top: 5px;
    }

    /* CATEGORIAS */
    .categories {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 15px;
    }

    .category {
      background: white;
      padding: 25px 10px;
      text-align: center;
      border-radius: 16px;
      box-shadow: var(--sombra);
      transition: .2s;
      cursor: pointer;
    }

    .category:hover {
      transform: translateY(-5px);
      border-bottom: 4px solid var(--verde);
    }

    .category-icon {
      font-size: 38px;
      display: block;
      margin-bottom: 8px;
    }

    /* FILTROS */
    .filters {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 25px;
      flex-wrap: wrap;
    }

    .filter-select {
      border: 1px solid #dce8e6;
      background: white;
      padding: 12px 15px;
      border-radius: 10px;
      outline: none;
    }

    /* PRODUTOS */
    .products {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .product {
      background: white;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: var(--sombra);
      transition: .25s;
      display: flex;
      flex-direction: column;
    }

    .product:hover {
      transform: translateY(-5px);
    }

    .product-image {
      height: 180px;
      background: linear-gradient(135deg, #ecfaf5, #eefaff);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 80px;
    }

    .product-info {
      padding: 18px;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .product-category {
      font-size: 12px;
      color: var(--verde-escuro);
      font-weight: bold;
      text-transform: uppercase;
    }

    .product h3 {
      margin: 5px 0;
      font-size: 18px;
    }

    .product-description {
      font-size: 14px;
      color: #718083;
      margin-bottom: 8px;
    }

    .stars {
      color: #ffb703;
      margin: 5px 0;
    }

    .price {
      font-size: 21px;
      font-weight: bold;
      color: var(--verde-escuro);
      margin: 8px 0 14px;
    }

    .product-buttons {
      display: grid;
      gap: 8px;
      margin-top: auto;
    }

    .btn-cart {
      width: 100%;
      padding: 11px;
      border-radius: 9px;
      background: var(--verde);
      color: white;
      font-weight: bold;
    }

    .btn-whatsapp {
      width: 100%;
      padding: 10px;
      border-radius: 9px;
      background: #25d366;
      color: white;
      font-weight: bold;
    }

    /* RECOMENDAÇÕES */
    .recommendations {
      background: #e9faf4;
      border-radius: 25px;
      padding: 30px;
    }

    /* SERVIÇOS */
    .services {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .service {
      background: white;
      padding: 25px;
      border-radius: 18px;
      box-shadow: var(--sombra);
      text-align: center;
    }

    .service-icon {
      font-size: 48px;
      margin-bottom: 10px;
    }

    .service p {
      color: #68797c;
      font-size: 14px;
      margin: 8px 0;
    }

    .service-price {
      font-size: 20px;
      font-weight: bold;
      color: var(--verde-escuro);
      margin: 12px;
    }

    /* SOBRE */
    .about {
      background: white;
      padding: 45px;
      border-radius: 25px;
      box-shadow: var(--sombra);
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 30px;
    }

    .stat {
      text-align: center;
      padding: 20px;
      background: #f0faf7;
      border-radius: 15px;
    }

    .stat strong {
      display: block;
      font-size: 30px;
      color: var(--verde-escuro);
    }

    /* CONTATO */
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }

    .contact-card,
    .form-card {
      background: white;
      padding: 30px;
      border-radius: 20px;
      box-shadow: var(--sombra);
    }

    .contact-item {
      margin: 15px 0;
      padding: 15px;
      background: #f3faf8;
      border-radius: 10px;
    }

    .form-group {
      margin-bottom: 15px;
    }

    .form-group label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
    }

    .form-control {
      width: 100%;
      padding: 12px;
      border: 1px solid #d7e4e1;
      border-radius: 9px;
      outline: none;
    }

    .form-control:focus {
      border-color: var(--verde);
    }

    textarea.form-control {
      min-height: 120px;
      resize: vertical;
    }

    /* FOOTER */
    footer {
      background: #123d35;
      color: white;
      padding: 45px 20px;
      margin-top: 70px;
    }

    .footer-content {
      max-width: 1200px;
      margin: auto;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 30px;
    }

    footer h3 {
      margin-bottom: 12px;
    }

    footer a {
      display: block;
      margin: 8px 0;
      color: #cce8df;
    }

    .copyright {
      max-width: 1200px;
      margin: 30px auto 0;
      padding-top: 20px;
      border-top: 1px solid rgba(255,255,255,.15);
      text-align: center;
      color: #b8d3cc;
    }

    /* WHATSAPP */
    .whatsapp {
      position: fixed;
      right: 22px;
      bottom: 22px;
      width: 58px;
      height: 58px;
      background: #25d366;
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 29px;
      box-shadow: 0 5px 20px rgba(0,0,0,.2);
      z-index: 999;
      transition: .2s;
    }

    .whatsapp:hover {
      transform: scale(1.08);
    }

    /* MODAL */
    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.55);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 2000;
    }

    .modal.active {
      display: flex;
    }

    .modal-content {
      background: white;
      width: 100%;
      max-width: 550px;
      max-height: 90vh;
      overflow-y: auto;
      border-radius: 20px;
      padding: 25px;
      position: relative;
    }

    .close {
      position: absolute;
      right: 18px;
      top: 15px;
      background: #f2f4f4;
      width: 35px;
      height: 35px;
      border-radius: 50%;
      font-size: 20px;
    }

    /* CARRINHO */
    .cart-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 15px 0;
      border-bottom: 1px solid #eee;
    }

    .cart-item-info {
      flex: 1;
    }

    .quantity {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .quantity button {
      width: 28px;
      height: 28px;
      border-radius: 6px;
      background: #e9f6f2;
    }

    .cart-total {
      font-size: 22px;
      font-weight: bold;
      text-align: right;
      margin: 20px 0;
      color: var(--verde-escuro);
    }

    /* TOAST */
    .toast {
      position: fixed;
      left: 50%;
      bottom: 25px;
      transform: translate(-50%, 100px);
      background: #183d36;
      color: white;
      padding: 13px 20px;
      border-radius: 10px;
      z-index: 3000;
      opacity: 0;
      transition: .3s;
    }

    .toast.show {
      transform: translate(-50%, 0);
      opacity: 1;
    }

    .empty {
      grid-column: 1 / -1;
      text-align: center;
      padding: 40px;
      background: white;
      border-radius: 15px;
    }

    /* ADMIN */
    .admin-panel {
      display: none;
    }

    .admin-panel.active {
      display: block;
    }

    .research-list {
      list-style: none;
    }

    .research-list li {
      background: #f3faf8;
      margin: 7px 0;
      padding: 12px;
      border-radius: 8px;
      display: flex;
      justify-content: space-between;
    }

    /* RESPONSIVO */
    @media (max-width: 1000px) {
      .products {
        grid-template-columns: repeat(3, 1fr);
      }

      .categories {
        grid-template-columns: repeat(3, 1fr);
      }

      .services {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 750px) {
      nav {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        right: 0;
        background: white;
        padding: 20px;
        flex-direction: column;
        box-shadow: var(--sombra);
      }

      nav.active {
        display: flex;
      }

      .hamburger {
        display: block;
      }

      .hero {
        grid-template-columns: 1fr;
        padding: 45px 25px;
        text-align: center;
      }

      .hero-image {
        font-size: 110px;
      }

      .buttons {
        justify-content: center;
      }

      .products {
        grid-template-columns: repeat(2, 1fr);
      }

      .contact-grid,
      .footer-content {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 500px) {
      .products,
      .services,
      .categories {
        grid-template-columns: 1fr;
      }

      .stats {
        grid-template-columns: 1fr;
      }

      .hero h1 {
        font-size: 38px;
      }

      .navbar {
        padding: 12px;
      }

      .logo {
        font-size: 21px;
      }

      .cart-button {
        padding: 8px 11px;
      }
    }
  </style>
</head>

<body>

  <!-- HEADER -->
  <header>
    <div class="navbar">
      <a href="#inicio" class="logo">🐾 Pet <span>Feliz</span></a>

      <nav id="menu">
        <a href="#inicio">Início</a>
        <a href="#produtos">Produtos</a>
        <a href="#servicos">Serviços</a>
        <a href="#sobre">Sobre</a>
        <a href="#contato">Contato</a>
      </nav>

      <div class="header-actions">
        <button class="cart-button" onclick="abrirCarrinho()">
          🛒 Carrinho (<span id="cartCount">0</span>)
        </button>
        <button class="hamburger" onclick="toggleMenu()">☰</button>
      </div>
    </div>
  </header>

  <!-- HERO -->
  <main id="inicio">
    <div class="hero">
      <div>
        <h1>Tudo para deixar seu pet ainda mais feliz! 🐶🐱</h1>

        <p>
          Produtos, cuidados e carinho para quem faz parte da sua família.
        </p>

        <div class="buttons">
          <a href="#produtos" class="btn btn-primary">
            Ver produtos
          </a>

          <a href="#servicos" class="btn btn-secondary">
            Agendar serviço
          </a>

          <a
            class="btn btn-secondary"
            target="_blank"
            href="https://wa.me/5541988708691?text=Ol%C3%A1!%20Vim%20pelo%20site%20da%20Pet%20Feliz."
          >
            💬 WhatsApp
          </a>
        </div>
      </div>

      <div class="hero-image">
        🐶 🐱
      </div>
    </div>

    <!-- PESQUISA -->
    <div class="search-area">
      <div class="search-box">
        <h2>🔎 O que seu pet precisa hoje?</h2>

        <input
          type="search"
          id="searchInput"
          class="search-input"
          placeholder="Digite: ração, brinquedo, cachorro, gato..."
          autocomplete="off"
        >

        <div class="search-suggestions">
          <span class="suggestion" onclick="pesquisarSugestao('ração')">Ração</span>
          <span class="suggestion" onclick="pesquisarSugestao('brinquedo')">Brinquedos</span>
          <span class="suggestion" onclick="pesquisarSugestao('gato')">Gatos</span>
          <span class="suggestion" onclick="pesquisarSugestao('cachorro')">Cachorros</span>
          <span class="suggestion" onclick="pesquisarSugestao('shampoo')">Higiene</span>
          <span class="suggestion" onclick="pesquisarSugestao('petisco')">Petiscos</span>
        </div>
      </div>
    </div>

    <!-- CATEGORIAS -->
    <section>
      <div class="section-title">
        <h2>Encontre por categoria</h2>
        <p>Escolha o que seu pet está precisando.</p>
      </div>

      <div class="categories">
        <div class="category" onclick="filtrarCategoria('Cachorros')">
          <span class="category-icon">🐶</span>
          Cachorros
        </div>

        <div class="category" onclick="filtrarCategoria('Gatos')">
          <span class="category-icon">🐱</span>
          Gatos
        </div>

        <div class="category" onclick="filtrarCategoria('Alimentação')">
          <span class="category-icon">🍖</span>
          Alimentação
        </div>

        <div class="category" onclick="filtrarCategoria('Brinquedos')">
          <span class="category-icon">🧸</span>
          Brinquedos
        </div>

        <div class="category" onclick="filtrarCategoria('Higiene')">
          <span class="category-icon">🧴</span>
          Higiene
        </div>

        <div class="category" onclick="filtrarCategoria('Acessórios')">
          <span class="category-icon">🛏️</span>
          Acessórios
        </div>
      </div>
    </section>

    <!-- PRODUTOS -->
    <section id="produtos">
      <div class="section-title">
        <h2>Nossos produtos</h2>
        <p>Produtos selecionados para cuidar do seu melhor amigo.</p>
      </div>

      <div class="filters">
        <select id="categoryFilter" class="filter-select">
          <option value="Todos">Todas as categorias</option>
          <option value="Cachorros">Cachorros</option>
          <option value="Gatos">Gatos</option>
          <option value="Alimentação">Alimentação</option>
          <option value="Brinquedos">Brinquedos</option>
          <option value="Higiene">Higiene</option>
          <option value="Acessórios">Acessórios</option>
        </select>

        <select id="sortFilter" class="filter-select">
          <option value="default">Ordenar produtos</option>
          <option value="low">Menor preço</option>
          <option value="high">Maior preço</option>
          <option value="name">Nome A-Z</option>
        </select>
      </div>

      <div class="products" id="productGrid"></div>
    </section>

    <!-- RECOMENDAÇÕES -->
    <section>
      <div class="recommendations">
        <div class="section-title">
          <h2>❤️ Talvez você também goste</h2>
          <p>Recomendações baseadas no que você procura.</p>
        </div>

        <div class="products" id="recommendationGrid"></div>
      </div>
    </section>

    <!-- SERVIÇOS -->
    <section id="servicos">
      <div class="section-title">
        <h2>🐾 Nossos serviços</h2>
        <p>Cuidamos do seu pet com muito carinho.</p>
      </div>

      <div class="services">

        <div class="service">
          <div class="service-icon">🛁</div>
          <h3>Banho</h3>
          <p>Banho completo para deixar seu pet limpo e cheiroso.</p>
          <div class="service-price">A partir de R$ 40</div>
          <button class="btn btn-primary" onclick="abrirAgendamento('Banho')">
            Agendar
          </button>
        </div>

        <div class="service">
          <div class="service-icon">✂️</div>
          <h3>Tosa</h3>
          <p>Tosa realizada com cuidado e atenção.</p>
          <div class="service-price">A partir de R$ 50</div>
          <button class="btn btn-primary" onclick="abrirAgendamento('Tosa')">
            Agendar
          </button>
        </div>

        <div class="service">
          <div class="service-icon">🐾</div>
          <h3>Banho + Tosa</h3>
          <p>Pacote completo para seu melhor amigo.</p>
          <div class="service-price">A partir de R$ 80</div>
          <button class="btn btn-primary" onclick="abrirAgendamento('Banho + Tosa')">
            Agendar
          </button>
        </div>

        <div class="service">
          <div class="service-icon">🏠</div>
          <h3>Day Care</h3>
          <p>Um espaço seguro e divertido para seu pet.</p>
          <div class="service-price">A partir de R$ 60</div>
          <button class="btn btn-primary" onclick="abrirAgendamento('Day Care')">
            Agendar
          </button>
        </div>

      </div>
    </section>

    <!-- SOBRE -->
    <section id="sobre">
      <div class="about">
        <div class="section-title">
          <h2>Sobre a Pet Feliz</h2>
        </div>

        <p>
          Na Pet Feliz, acreditamos que nossos animais merecem todo amor,
          cuidado e carinho. Nossa missão é oferecer produtos de qualidade
          e serviços especiais para tornar a vida dos pets ainda mais feliz.
        </p>

        <div class="stats">
          <div class="stat">
            <strong>+5.000</strong>
            Pets atendidos
          </div>

          <div class="stat">
            <strong>+10</strong>
            Anos de experiência
          </div>

          <div class="stat">
            <strong>+2.000</strong>
            Clientes satisfeitos
          </div>
        </div>
      </div>
    </section>

    <!-- CONTATO -->
    <section id="contato">
      <div class="section-title">
        <h2>Entre em contato</h2>
        <p>Estamos prontos para atender você.</p>
      </div>

      <div class="contact-grid">

        <div class="contact-card">
          <h2>📍 Pet Feliz</h2>

          <div class="contact-item">
            📱 <strong>WhatsApp</strong><br>
            (41) 98870-8691
          </div>

          <div class="contact-item">
            📧 <strong>E-mail</strong><br>
            contato@petfeliz.com
          </div>

          <div class="contact-item">
            🕐 <strong>Horário</strong><br>
            Segunda a sábado: 08:00 às 18:00
          </div>

          <div class="contact-item">
            📍 <strong>Endereço</strong><br>
            Rua dos Animais, 100 - Curitiba/PR
          </div>

          <a
            class="btn btn-primary"
            target="_blank"
            href="https://wa.me/5541988708691"
          >
            💬 Falar pelo WhatsApp
          </a>
        </div>

        <div class="form-card">
          <h2>Envie uma mensagem</h2>

          <form id="contactForm">
            <div class="form-group">
              <label>Nome</label>
              <input class="form-control" id="contactName" required>
            </div>

            <div class="form-group">
              <label>E-mail</label>
              <input type="email" class="form-control" id="contactEmail" required>
            </div>

            <div class="form-group">
              <label>Telefone</label>
              <input class="form-control" id="contactPhone" required>
            </div>

            <div class="form-group">
              <label>Mensagem</label>
              <textarea class="form-control" id="contactMessage" required></textarea>
            </div>

            <button class="btn btn-primary" type="submit">
              Enviar mensagem
            </button>
          </form>
        </div>

      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer>
    <div class="footer-content">

      <div>
        <h2>🐾 Pet Feliz</h2>
        <p>
          Tudo para cuidar, mimar e deixar seu pet ainda mais feliz.
        </p>
      </div>

      <div>
        <h3>Links</h3>
        <a href="#inicio">Início</a>
        <a href="#produtos">Produtos</a>
        <a href="#servicos">Serviços</a>
        <a href="#contato">Contato</a>
      </div>

      <div>
        <h3>Contato</h3>
        <a href="tel:+5541988708691">(41) 98870-8691</a>
        <a target="_blank" href="https://wa.me/5541988708691">
          WhatsApp
        </a>
      </div>

    </div>

    <div class="copyright">
      © 2026 Pet Feliz. Todos os direitos reservados.
    </div>
  </footer>

  <!-- WHATSAPP FLUTUANTE -->
  <a
    class="whatsapp"
    target="_blank"
    href="https://wa.me/5541988708691?text=Ol%C3%A1!%20Vim%20pelo%20site%20da%20Pet%20Feliz."
    aria-label="Falar no WhatsApp"
  >
    💬
  </a>

  <!-- MODAL CARRINHO -->
  <div class="modal" id="cartModal">
    <div class="modal-content">

      <button class="close" onclick="fecharModal('cartModal')">×</button>

      <h2>🛒 Seu carrinho</h2>

      <div id="cartItems"></div>

      <div class="cart-total">
        Total: R$ <span id="cartTotal">0,00</span>
      </div>

      <button class="btn btn-primary" style="width:100%" onclick="finalizarWhatsApp()">
        💬 Finalizar pelo WhatsApp
      </button>

      <button
        class="btn"
        style="width:100%; margin-top:8px; background:#eee"
        onclick="limparCarrinho()"
      >
        Esvaziar carrinho
      </button>

    </div>
  </div>

  <!-- MODAL AGENDAMENTO -->
  <div class="modal" id="appointmentModal">
    <div class="modal-content">

      <button class="close" onclick="fecharModal('appointmentModal')">×</button>

      <h2>📅 Agendar serviço</h2>

      <form id="appointmentForm">

        <div class="form-group">
          <label>Nome do cliente</label>
          <input class="form-control" id="clientName" required>
        </div>

        <div class="form-group">
          <label>Nome do pet</label>
          <input class="form-control" id="petName" required>
        </div>

        <div class="form-group">
          <label>Tipo de animal</label>
          <select class="form-control" id="petType" required>
            <option value="">Selecione</option>
            <option>Cachorro</option>
            <option>Gato</option>
            <option>Outro</option>
          </select>
        </div>

        <div class="form-group">
          <label>Serviço</label>
          <input class="form-control" id="serviceName" readonly>
        </div>

        <div class="form-group">
          <label>Data</label>
          <input type="date" class="form-control" id="appointmentDate" required>
        </div>

        <div class="form-group">
          <label>Horário</label>
          <input type="time" class="form-control" id="appointmentTime" required>
        </div>

        <div class="form-group">
          <label>Telefone</label>
          <input class="form-control" id="clientPhone" required>
        </div>

        <button class="btn btn-primary" style="width:100%">
          📲 Agendar pelo WhatsApp
        </button>

      </form>
    </div>
  </div>

  <!-- TOAST -->
  <div class="toast" id="toast"></div>

  <script>
    /* ==========================================
       CONFIGURAÇÕES
    ========================================== */

    const WHATSAPP = "5541988708691";

    /* ==========================================
       PRODUTOS
    ========================================== */

    const produtos = [
      {
        id: 1,
        nome: "Ração Premium para Cães",
        categoria: "Alimentação",
        tags: "ração cachorro cão alimentação",
        preco: 89.90,
        emoji: "🥩",
        descricao: "Alimento premium completo para cães.",
        avaliacao: 5
      },
      {
        id: 2,
        nome: "Ração Premium para Gatos",
        categoria: "Alimentação",
        tags: "ração gato gatos alimentação",
        preco: 74.90,
        emoji: "🐟",
        descricao: "Nutrição completa para gatos.",
        avaliacao: 5
      },
      {
        id: 3,
        nome: "Petisco Natural para Cães",
        categoria: "Alimentação",
        tags: "petisco cachorro cão comida",
        preco: 24.90,
        emoji: "🦴",
        descricao: "Petisco natural para seu melhor amigo.",
        avaliacao: 5
      },
      {
        id: 4,
        nome: "Petisco para Gatos",
        categoria: "Alimentação",
        tags: "petisco gato gatos comida",
        preco: 22.90,
        emoji: "🐟",
        descricao: "Delicioso petisco para gatos.",
        avaliacao: 4
      },
      {
        id: 5,
        nome: "Brinquedo Mordedor",
        categoria: "Brinquedos",
        tags: "brinquedo cachorro cão mordedor",
        preco: 29.90,
        emoji: "🧸",
        descricao: "Brinquedo resistente para cães.",
        avaliacao: 5
      },
      {
        id: 6,
        nome: "Bolinha para Gatos",
        categoria: "Brinquedos",
        tags: "brinquedo gato gatos bolinha",
        preco: 19.90,
        emoji: "⚽",
        descricao: "Diversão garantida para seu gato.",
        avaliacao: 4
      },
      {
        id: 7,
        nome: "Shampoo Pet",
        categoria: "Higiene",
        tags: "shampoo higiene banho cachorro gato",
        preco: 34.90,
        emoji: "🧴",
        descricao: "Shampoo suave para cães e gatos.",
        avaliacao: 5
      },
      {
        id: 8,
        nome: "Cama para Cachorro",
        categoria: "Acessórios",
        tags: "cama cachorro cão dormir acessório",
        preco: 129.90,
        emoji: "🛏️",
        descricao: "Cama confortável e macia.",
        avaliacao: 5
      },
      {
        id: 9,
        nome: "Coleira Ajustável",
        categoria: "Acessórios",
        tags: "coleira cachorro cão passeio acessório",
        preco: 39.90,
        emoji: "🐕",
        descricao: "Coleira ajustável e confortável.",
        avaliacao: 4
      },
      {
        id: 10,
        nome: "Arranhador para Gatos",
        categoria: "Acessórios",
        tags: "arranhador gato gatos acessório",
        preco: 99.90,
        emoji: "🐈",
        descricao: "Diversão e conforto para gatos.",
        avaliacao: 5
      },
      {
        id: 11,
        nome: "Comedouro Pet",
        categoria: "Acessórios",
        tags: "comedouro cachorro gato alimentação",
        preco: 44.90,
        emoji: "🥣",
        descricao: "Comedouro prático para seu pet.",
        avaliacao: 4
      },
      {
        id: 12,
        nome: "Areia Sanitária",
        categoria: "Higiene",
        tags: "areia gato gatos higiene banheiro",
        preco: 39.90,
        emoji: "🧹",
        descricao: "Areia sanitária para gatos.",
        avaliacao: 5
      }
    ];

    let carrinho = JSON.parse(localStorage.getItem("petfeliz_carrinho")) || [];
    let historico = JSON.parse(localStorage.getItem("petfeliz_pesquisas")) || [];

    /* ==========================================
       UTILIDADES
    ========================================== */

    function normalizar(texto) {
      return texto
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }

    function formatarPreco(valor) {
      return valor.toLocaleString("pt-BR", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    function mostrarToast(mensagem) {
      const toast = document.getElementById("toast");

      toast.textContent = mensagem;
      toast.classList.add("show");

      setTimeout(() => {
        toast.classList.remove("show");
      }, 2500);
    }

    /* ==========================================
       PRODUTOS
    ========================================== */

    function renderProdutos(lista = produtos, elemento = "productGrid") {

      const grid = document.getElementById(elemento);

      if (!lista.length) {
        grid.innerHTML = `
          <div class="empty">
            <h3>😿 Nenhum produto encontrado</h3>
            <p>Tente pesquisar outro termo.</p>
          </div>
        `;
        return;
      }

      grid.innerHTML = lista.map(produto => `
        <article class="product">

          <div class="product-image">
            ${produto.emoji}
          </div>

          <div class="product-info">

            <span class="product-category">
              ${produto.categoria}
            </span>

            <h3>${produto.nome}</h3>

            <p class="product-description">
              ${produto.descricao}
            </p>

            <div class="stars">
              ${"★".repeat(produto.avaliacao)}
              ${"☆".repeat(5 - produto.avaliacao)}
            </div>

            <div class="price">
              R$ ${formatarPreco(produto.preco)}
            </div>

            <div class="product-buttons">

              <button
                class="btn-cart"
                onclick="adicionarCarrinho(${produto.id})"
              >
                🛒 Adicionar
              </button>

              <button
                class="btn-whatsapp"
                onclick="comprarWhatsApp(${produto.id})"
              >
                💬 Comprar pelo WhatsApp
              </button>

            </div>

          </div>

        </article>
      `).join("");
    }

    /* ==========================================
       PESQUISA
    ========================================== */

    const searchInput = document.getElementById("searchInput");

    searchInput.addEventListener("input", function() {

      const termo = normalizar(this.value.trim());

      if (termo.length >= 2) {
        salvarPesquisa(this.value.trim());
      }

      const resultado = produtos.filter(produto => {

        const texto = normalizar(
          produto.nome + " " +
          produto.categoria + " " +
          produto.tags + " " +
          produto.descricao
        );

        return texto.includes(termo);
      });

      renderProdutos(resultado);

      atualizarRecomendacoes(termo);
    });

    function pesquisarSugestao(termo) {
      searchInput.value = termo;
      searchInput.dispatchEvent(new Event("input"));

      document.getElementById("produtos").scrollIntoView({
        behavior: "smooth"
      });
    }

    function salvarPesquisa(termo) {

      if (!termo || termo.length < 2) return;

      const chave = normalizar(termo);

      const existente = historico.find(
        item => item.chave === chave
      );

      if (existente) {
        existente.quantidade++;
        existente.ultimaPesquisa = new Date().toISOString();
      } else {
        historico.push({
          termo: termo,
          chave: chave,
          quantidade: 1,
          ultimaPesquisa: new Date().toISOString()
        });
      }

      localStorage.setItem(
        "petfeliz_pesquisas",
        JSON.stringify(historico)
      );
    }

    /* ==========================================
       RECOMENDAÇÕES
    ========================================== */

    function atualizarRecomendacoes(termo = "") {

      let recomendados = [];

      if (termo) {
        recomendados = produtos.filter(produto => {

          const texto = normalizar(
            produto.nome + " " +
            produto.tags + " " +
            produto.categoria
          );

          return texto.includes(termo);
        });
      }

      if (!recomendados.length && historico.length) {

        const pesquisas = [...historico]
          .sort((a,b) => b.quantidade - a.quantidade)
          .slice(0, 3);

        pesquisas.forEach(pesquisa => {

          produtos.forEach(produto => {

            const texto = normalizar(
              produto.nome + " " +
              produto.tags + " " +
              produto.categoria
            );

            if (
              texto.includes(pesquisa.chave) &&
              !recomendados.includes(produto)
            ) {
              recomendados.push(produto);
            }

          });

        });
      }

      if (!recomendados.length) {
        recomendados = produtos.slice(0, 4);
      }

      renderProdutos(
        recomendados.slice(0, 4),
        "recommendationGrid"
      );
    }

    /* ==========================================
       FILTROS
    ========================================== */

    function filtrarCategoria(categoria) {

      document.getElementById("categoryFilter").value = categoria;

      const resultado = produtos.filter(
        produto => produto.categoria === categoria
      );

      renderProdutos(resultado);

      document.getElementById("produtos").scrollIntoView({
        behavior: "smooth"
      });
    }

    document.getElementById("categoryFilter")
      .addEventListener("change", aplicarFiltros);

    document.getElementById("sortFilter")
      .addEventListener("change", aplicarFiltros);

    function aplicarFiltros() {

      const categoria =
        document.getElementById("categoryFilter").value;

      const ordem =
        document.getElementById("sortFilter").value;

      let lista = [...produtos];

      if (categoria !== "Todos") {
        lista = lista.filter(
          produto => produto.categoria === categoria
        );
      }

      if (ordem === "low") {
        lista.sort((a,b) => a.preco - b.preco);
      }

      if (ordem === "high") {
        lista.sort((a,b) => b.preco - a.preco);
      }

      if (ordem === "name") {
        lista.sort((a,b) =>
          a.nome.localeCompare(b.nome)
        );
      }

      renderProdutos(lista);
    }

    /* ==========================================
       CARRINHO
    ========================================== */

    function salvarCarrinho() {
      localStorage.setItem(
        "petfeliz_carrinho",
        JSON.stringify(carrinho)
      );
    }

    function adicionarCarrinho(id) {

      const produto = produtos.find(
        item => item.id === id
      );

      const existente = carrinho.find(
        item => item.id === id
      );

      if (existente) {
        existente.quantidade++;
      } else {
        carrinho.push({
          id: produto.id,
          quantidade: 1
        });
      }

      salvarCarrinho();
      atualizarCarrinho();

      mostrarToast(
        produto.nome + " foi adicionado ao carrinho! 🛒"
      );
    }

    function atualizarCarrinho() {

      const quantidade = carrinho.reduce(
        (total, item) => total + item.quantidade,
        0
      );

      document.getElementById("cartCount").textContent =
        quantidade;

      const container =
        document.getElementById("cartItems");

      if (!carrinho.length) {
        container.innerHTML = `
          <div class="empty">
            <h3>🛒 Seu carrinho está vazio</h3>
            <p>Adicione produtos para continuar.</p>
          </div>
        `;

        document.getElementById("cartTotal").textContent =
          "0,00";

        return;
      }

      let total = 0;

      container.innerHTML = carrinho.map(item => {

        const produto = produtos.find(
          p => p.id === item.id
        );

        const subtotal =
          produto.preco * item.quantidade;

        total += subtotal;

        return `
          <div class="cart-item">

            <div class="cart-item-info">
              <strong>${produto.nome}</strong><br>
              R$ ${formatarPreco(produto.preco)}
            </div>

            <div class="quantity">
              <button onclick="alterarQuantidade(${produto.id}, -1)">
                −
              </button>

              <strong>${item.quantidade}</strong>

              <button onclick="alterarQuantidade(${produto.id}, 1)">
                +
              </button>
            </div>

            <button
              onclick="removerCarrinho(${produto.id})"
              style="background:none;color:#ef476f;font-size:20px"
            >
              🗑️
            </button>

          </div>
        `;

      }).join("");

      document.getElementById("cartTotal").textContent =
        formatarPreco(total);
    }

    function alterarQuantidade(id, valor) {

      const item = carrinho.find(
        item => item.id === id
      );

      if (!item) return;

      item.quantidade += valor;

      if (item.quantidade <= 0) {
        carrinho = carrinho.filter(
          item => item.id !== id
        );
      }

      salvarCarrinho();
      atualizarCarrinho();
    }

    function removerCarrinho(id) {

      carrinho = carrinho.filter(
        item => item.id !== id
      );

      salvarCarrinho();
      atualizarCarrinho();
    }

    function limparCarrinho() {

      carrinho = [];

      salvarCarrinho();
      atualizarCarrinho();

      mostrarToast("Carrinho esvaziado.");
    }

    function abrirCarrinho() {

      atualizarCarrinho();

      document.getElementById("cartModal")
        .classList.add("active");
    }

    function finalizarWhatsApp() {

      if (!carrinho.length) {
        mostrarToast("Seu carrinho está vazio.");
        return;
      }

      let mensagem =
        "Olá! Gostaria de fazer um pedido na Pet Feliz.%0A%0A";

      let total = 0;

      carrinho.forEach(item => {

        const produto = produtos.find(
          p => p.id === item.id
        );

        const subtotal =
          produto.preco * item.quantidade;

        total += subtotal;

        mensagem +=
          `• ${produto.nome} - ${item.quantidade}x - R$ ${formatarPreco(subtotal)}%0A`;
      });

      mensagem +=
        `%0A*Total: R$ ${formatarPreco(total)}*`;

      window.open(
        `https://wa.me/${WHATSAPP}?text=${mensagem}`,
        "_blank"
      );
    }

    function comprarWhatsApp(id) {

      const produto = produtos.find(
        p => p.id === id
      );

      const mensagem =
        `Olá! Tenho interesse no produto *${produto.nome}*, no valor de R$ ${formatarPreco(produto.preco)}. Gostaria de saber mais informações.`;

      window.open(
        `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(mensagem)}`,
        "_blank"
      );
    }

    /* ==========================================
       AGENDAMENTO
    ========================================== */

    function abrirAgendamento(servico) {

      document.getElementById("serviceName").value =
        servico;

      document.getElementById("appointmentModal")
        .classList.add("active");
    }

    document.getElementById("appointmentForm")
      .addEventListener("submit", function(event) {

        event.preventDefault();

        const cliente =
          document.getElementById("clientName").value;

        const pet =
          document.getElementById("petName").value;

        const animal =
          document.getElementById("petType").value;

        const servico =
          document.getElementById("serviceName").value;

        const data =
          document.getElementById("appointmentDate").value;

        const horario =
          document.getElementById("appointmentTime").value;

        const telefone =
          document.getElementById("clientPhone").value;

        const mensagem =
          `Olá! Gostaria de agendar um serviço na Pet Feliz.%0A%0A` +
          `*Cliente:* ${cliente}%0A` +
          `*Pet:* ${pet}%0A` +
          `*Animal:* ${animal}%0A` +
          `*Serviço:* ${servico}%0A` +
          `*Data:* ${data}%0A` +
          `*Horário:* ${horario}%0A` +
          `*Telefone:* ${telefone}`;

        window.open(
          `https://wa.me/${WHATSAPP}?text=${mensagem}`,
          "_blank"
        );

        fecharModal("appointmentModal");
      });

    /* ==========================================
       CONTATO
    ========================================== */

    document.getElementById("contactForm")
      .addEventListener("submit", function(event) {

        event.preventDefault();

        const nome =
          document.getElementById("contactName").value;

        const mensagem =
          document.getElementById("contactMessage").value;

        const texto =
          `Olá! Sou ${nome}.%0A%0A${mensagem}`;

        window.open(
          `https://wa.me/${WHATSAPP}?text=${texto}`,
          "_blank"
        );

        this.reset();
      });

    /* ==========================================
       MODAIS
    ========================================== */

    function fecharModal(id) {
      document.getElementById(id)
        .classList.remove("active");
    }

    window.addEventListener("click", function(event) {

      if (event.target.classList.contains("modal")) {
        event.target.classList.remove("active");
      }

    });

    /* ==========================================
       MENU MOBILE
    ========================================== */

    function toggleMenu() {
      document.getElementById("menu")
        .classList.toggle("active");
    }

    document.querySelectorAll("nav a").forEach(link => {
      link.addEventListener("click", () => {
        document.getElementById("menu")
          .classList.remove("active");
      });
    });

    /* ==========================================
       INICIALIZAÇÃO
    ========================================== */

    renderProdutos();
    atualizarCarrinho();
    atualizarRecomendacoes();

  </script>

</body>
</html>