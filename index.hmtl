<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Pet Mania | Pet Shop</title>

    <link rel="stylesheet" href="style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Poppins:wght@400;500;600&display=swap"
        rel="stylesheet">
</head>

<body>

    <!-- =========================
         MENU
    ========================== -->

    <header>

        <div class="logo">
            🐾 Pet<span>Mania</span>
        </div>

        <nav>
            <a href="#inicio">Início</a>
            <a href="#sobre">Sobre</a>
            <a href="#produtos">Produtos</a>
            <a href="#cuidados">Cuidados</a>
            <a href="#contato">Contato</a>
        </nav>

        <a href="#contato" class="menu-button">
            Fale conosco
        </a>

    </header>


    <main>

        <!-- =========================
             INÍCIO
        ========================== -->

        <section class="inicio" id="inicio">

            <div class="inicio-texto">

                <div class="etiqueta">
                    🐶 Tudo para seu melhor amigo
                </div>

                <h1>
                    Seu pet merece
                    <span>todo o amor!</span>
                </h1>

                <p>
                    Encontre dicas, produtos e cuidados especiais
                    para deixar seu cachorro ou gato ainda mais
                    feliz e saudável.
                </p>

                <div class="botoes">

                    <a href="#produtos" class="botao-principal">
                        Ver produtos 🛒
                    </a>

                    <a href="#sobre" class="botao-secundario">
                        Conheça a PetMania
                    </a>

                </div>

            </div>


            <!-- IMAGEM 1 -->

            <div class="imagem imagem-principal">

                <img src="images/pet1.jpg"
                    alt="Animal de estimação">

                <div class="adesivo">
                    ❤️
                    <strong>Amor em cada detalhe!</strong>
                </div>

            </div>

        </section>


        <!-- =========================
             SOBRE
        ========================== -->

        <section class="sobre" id="sobre">

            <div class="titulo">

                <small>🐾 SOBRE A PETMANIA</small>

                <h2>
                    Um lugar feito para
                    <span>amar os animais</span>
                </h2>

                <p>
                    A PetMania é um espaço criado para todos que
                    consideram seus animais parte da família.
                </p>

            </div>


            <div class="sobre-grid">

                <div class="sobre-card">

                    <div class="icone">
                        ❤️
                    </div>

                    <h3>
                        Muito carinho
                    </h3>

                    <p>
                        Tratamos cada pet com atenção, respeito
                        e muito carinho.
                    </p>

                </div>


                <div class="sobre-card">

                    <div class="icone">
                        ⭐
                    </div>

                    <h3>
                        Qualidade
                    </h3>

                    <p>
                        Buscamos oferecer produtos de qualidade
                        para seu melhor amigo.
                    </p>

                </div>


                <div class="sobre-card">

                    <div class="icone">
                        🐕
                    </div>

                    <h3>
                        Bem-estar
                    </h3>

                    <p>
                        Nosso objetivo é ajudar os animais a terem
                        uma vida mais feliz e saudável.
                    </p>

                </div>

            </div>

        </section>


        <!-- =========================
             PRODUTOS
        ========================== -->

        <section class="produtos" id="produtos">

            <div class="titulo">

                <small>🛒 PET SHOP</small>

                <h2>
                    Produtos para o seu
                    <span>melhor amigo</span>
                </h2>

                <p>
                    Confira algumas categorias que não podem faltar
                    na rotina do seu pet.
                </p>

            </div>


            <div class="produtos-grid">


                <div class="produto">

                    <div class="produto-icone">
                        🥩
                    </div>

                    <h3>
                        Alimentação
                    </h3>

                    <p>
                        Rações e petiscos para manter seu pet
                        bem alimentado.
                    </p>

                    <a href="#">
                        Ver produtos →
                    </a>

                </div>


                <div class="produto">

                    <div class="produto-icone">
                        🧸
                    </div>

                    <h3>
                        Brinquedos
                    </h3>

                    <p>
                        Brinquedos divertidos para estimular
                        seu animal.
                    </p>

                    <a href="#">
                        Ver produtos →
                    </a>

                </div>


                <div class="produto">

                    <div class="produto-icone">
                        🛏️
                    </div>

                    <h3>
                        Camas
                    </h3>

                    <p>
                        Caminhas confortáveis para seu pet
                        descansar.
                    </p>

                    <a href="#">
                        Ver produtos →
                    </a>

                </div>


                <div class="produto">

                    <div class="produto-icone">
                        🦮
                    </div>

                    <h3>
                        Acessórios
                    </h3>

                    <p>
                        Coleiras, guias, potes e muito mais.
                    </p>

                    <a href="#">
                        Ver produtos →
                    </a>

                </div>

            </div>

        </section>


        <!-- =========================
             DESTAQUE COM IMAGEM 2
        ========================== -->

        <section class="destaque">

            <!-- IMAGEM 2 -->

            <div class="imagem destaque-imagem">

                <img src="images/pet2.jpg"
                    alt="Cachorro feliz">

            </div>


            <div class="destaque-texto">

                <div class="etiqueta">
                    🐶 DICA PARA CACHORROS
                </div>

                <h2>
                    Uma rotina saudável
                    deixa seu pet mais feliz
                </h2>

                <p>
                    Passeios, brincadeiras, alimentação adequada
                    e consultas veterinárias são alguns dos cuidados
                    importantes para o bem-estar dos cachorros.
                </p>


                <div class="lista">

                    <div>
                        <span>✓</span>
                        Passeie com seu cachorro.
                    </div>

                    <div>
                        <span>✓</span>
                        Deixe água fresca disponível.
                    </div>

                    <div>
                        <span>✓</span>
                        Escolha uma alimentação adequada.
                    </div>

                    <div>
                        <span>✓</span>
                        Separe um tempo para brincar.
                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             GATOS
        ========================== -->

        <section class="gatos">

            <div class="gatos-texto">

                <div class="etiqueta">
                    🐱 PARA OS GATEIROS
                </div>

                <h2>
                    Seu gato também precisa
                    de <span>carinho e atenção</span>
                </h2>

                <p>
                    Apesar de independentes, os gatos precisam de
                    cuidados, brincadeiras e um ambiente seguro
                    para viverem bem.
                </p>

                <a href="#cuidados" class="botao-principal">
                    Ver cuidados
                </a>

            </div>


            <!-- IMAGEM 3 -->

            <div class="imagem gato-imagem">

                <img src="images/pet3.jpg"
                    alt="Gato de estimação">

                <div class="gato-frase">
                    🐱 Ronronar é felicidade!
                </div>

            </div>

        </section>


        <!-- =========================
             CUIDADOS
        ========================== -->

        <section class="cuidados" id="cuidados">

            <div class="titulo">

                <small>💚 CUIDADOS</small>

                <h2>
                    Como cuidar melhor do
                    <span>seu pet?</span>
                </h2>

                <p>
                    Algumas atitudes simples podem fazer uma
                    grande diferença na vida do seu animal.
                </p>

            </div>


            <div class="cuidados-grid">

                <div class="cuidado">

                    <span>01</span>

                    <div>
                        <h3>
                            Alimentação
                        </h3>

                        <p>
                            Ofereça uma alimentação adequada
                            para a idade e tamanho do seu pet.
                        </p>
                    </div>

                </div>


                <div class="cuidado">

                    <span>02</span>

                    <div>
                        <h3>
                            Higiene
                        </h3>

                        <p>
                            Mantenha seu animal limpo e cuide
                            regularmente da higiene.
                        </p>
                    </div>

                </div>


                <div class="cuidado">

                    <span>03</span>

                    <div>
                        <h3>
                            Exercícios
                        </h3>

                        <p>
                            Brincadeiras e passeios ajudam
                            a manter o animal ativo.
                        </p>
                    </div>

                </div>


                <div class="cuidado">

                    <span>04</span>

                    <div>
                        <h3>
                            Veterinário
                        </h3>

                        <p>
                            Consultas regulares ajudam a
                            prevenir problemas de saúde.
                        </p>
                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             ÚLTIMA IMAGEM
        ========================== -->

        <section class="momento">

            <!-- IMAGEM 4 -->

            <div class="imagem momento-imagem">

                <img src="images/pet4.jpg"
                    alt="Animal recebendo carinho">

            </div>


            <div class="momento-texto">

                <div class="etiqueta">
                    ❤️ MOMENTO PET
                </div>

                <h2>
                    Mais que um animal,
                    <span>parte da família.</span>
                </h2>

                <p>
                    Ter um pet é ganhar um companheiro para os
                    melhores e mais simples momentos da vida.
                </p>

                <div class="frase">
                    "O amor de um animal transforma
                    qualquer casa em um lar."
                </div>

            </div>

        </section>


        <!-- =========================
             CONTATO
        ========================== -->

        <section class="contato" id="contato">

            <div class="contato-conteudo">

                <div>

                    <small>
                        🐾 FALE COM A PETMANIA
                    </small>

                    <h2>
                        Vamos cuidar juntos
                        do seu melhor amigo?
                    </h2>

                    <p>
                        Entre em contato para conhecer nossos
                        produtos e serviços.
                    </p>

                </div>


                <div class="contato-info">

                    <div>
                        📍
                        <strong>
                            Endereço
                        </strong>

                        <span>
                            Rua dos Pets, 100
                        </span>
                    </div>


                    <div>
                        📞
                        <strong>
                            Telefone
                        </strong>

                        <span>
                            (11) 99999-9999
                        </span>
                    </div>


                    <div>
                        ✉️
                        <strong>
                            E-mail
                        </strong>

                        <span>
                            contato@petmania.com
                        </span>
                    </div>

                </div>

            </div>

        </section>

    </main>


    <!-- =========================
         RODAPÉ
    ========================== -->

    <footer>

        <div class="footer-conteudo">

            <div>

                <div class="logo">
                    🐾 Pet<span>Mania</span>
                </div>

                <p>
                    Cuidando de quem faz parte
                    da nossa família.
                </p>

            </div>


            <div>

                <h3>
                    Navegação
                </h3>

                <a href="#inicio">
                    Início
                </a>

                <a href="#sobre">
                    Sobre
                </a>

                <a href="#produtos">
                    Produtos
                </a>

                <a href="#contato">
                    Contato
                </a>

            </div>


            <div>

                <h3>
                    Redes sociais
                </h3>

                <div class="redes">

                    <a href="#">
                        Instagram
                    </a>

                    <a href="#">
                        Facebook
                    </a>

                    <a href="#">
                        WhatsApp
                    </a>

                </div>

            </div>

        </div>


        <div class="copyright">

            © 2026 PetMania — Desenvolvido com ❤️ 🐾

        </div>

    </footer>

</body>

</html>