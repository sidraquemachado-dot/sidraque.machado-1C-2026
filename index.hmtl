<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
        content="Patas & Carinho - Blog completo sobre cuidados, alimentação, saúde e bem-estar dos animais de estimação.">

    <title>Patas & Carinho | Pet Shop</title>

    <!-- Fonte do Google -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- =========================
         CABEÇALHO
    ========================== -->
    <header class="header">

        <div class="container nav-container">

            <a href="#inicio" class="logo">
                <span class="logo-paw">🐾</span>
                <span>Patas <strong>&</strong> Carinho</span>
            </a>

            <nav class="nav">
                <a href="#inicio">Início</a>
                <a href="#sobre">Sobre</a>
                <a href="#cuidados">Cuidados</a>
                <a href="#servicos">Serviços</a>
                <a href="#contato">Contato</a>
            </nav>

            <a href="#servicos" class="btn btn-small">
                Conheça nosso Pet Shop
            </a>

        </div>

    </header>


    <main>

        <!-- =========================
             HERO
        ========================== -->
        <section class="hero" id="inicio">

            <div class="container hero-content">

                <div class="hero-text">

                    <span class="tag">
                        🐶 Amor que vira cuidado
                    </span>

                    <h1>
                        Tudo para deixar seu
                        <span>melhor amigo</span>
                        feliz!
                    </h1>

                    <p>
                        Bem-vindo ao <strong>Patas & Carinho</strong>, um espaço
                        criado para quem ama animais e quer oferecer uma vida
                        mais saudável, divertida e cheia de carinho para seus
                        pets.
                    </p>

                    <div class="hero-buttons">
                        <a href="#cuidados" class="btn">
                            Descobrir dicas 🐾
                        </a>

                        <a href="#sobre" class="btn btn-outline">
                            Conheça o blog
                        </a>
                    </div>

                    <div class="hero-info">

                        <div>
                            <strong>100%</strong>
                            <span>Amor pelos pets</span>
                        </div>

                        <div>
                            <strong>+50</strong>
                            <span>Dicas especiais</span>
                        </div>

                        <div>
                            <strong>🐾</strong>
                            <span>Feito com carinho</span>
                        </div>

                    </div>

                </div>


                <!-- IMAGEM 1 -->
                <div class="hero-image image-slot">

                    <img src="images/pet-hero.jpg"
                        alt="Cachorro feliz representando o Pet Shop">

                    <div class="image-badge">
                        <span>❤️</span>
                        <div>
                            <strong>Pet feliz</strong>
                            <small>é pet bem cuidado!</small>
                        </div>
                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             SOBRE
        ========================== -->
        <section class="about section" id="sobre">

            <div class="container">

                <div class="section-title">

                    <span class="tag">🐾 Quem somos</span>

                    <h2>
                        Um cantinho feito para
                        <span>quem ama animais</span>
                    </h2>

                    <p>
                        O Patas & Carinho nasceu para compartilhar informações
                        simples e úteis sobre o universo dos animais de
                        estimação.
                    </p>

                </div>


                <div class="about-grid">

                    <div class="about-card">

                        <div class="icon">❤️</div>

                        <h3>Amor</h3>

                        <p>
                            Acreditamos que todo pet merece receber atenção,
                            carinho e muito amor todos os dias.
                        </p>

                    </div>


                    <div class="about-card">

                        <div class="icon">🥕</div>

                        <h3>Alimentação</h3>

                        <p>
                            Uma alimentação equilibrada é essencial para manter
                            seu companheiro saudável e cheio de energia.
                        </p>

                    </div>


                    <div class="about-card">

                        <div class="icon">🏃</div>

                        <h3>Diversão</h3>

                        <p>
                            Brincadeiras e atividades ajudam a manter os pets
                            ativos, felizes e estimulados.
                        </p>

                    </div>


                    <div class="about-card">

                        <div class="icon">🩺</div>

                        <h3>Saúde</h3>

                        <p>
                            Cuidados preventivos e acompanhamento veterinário
                            ajudam a garantir uma vida longa e saudável.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             DESTAQUE
        ========================== -->
        <section class="highlight">

            <div class="container highlight-content">

                <div>

                    <span class="tag light">
                        🐕 Dica do dia
                    </span>

                    <h2>
                        Seu pet também precisa
                        de uma rotina saudável!
                    </h2>

                    <p>
                        Separe alguns minutos do dia para brincar, passear,
                        oferecer água fresca e dar bastante carinho.
                        Pequenas atitudes fazem uma grande diferença.
                    </p>

                    <a href="#cuidados" class="btn btn-white">
                        Ver mais dicas
                    </a>

                </div>

                <div class="highlight-paw">
                    🐾
                </div>

            </div>

        </section>


        <!-- =========================
             CUIDADOS
        ========================== -->
        <section class="care section" id="cuidados">

            <div class="container">

                <div class="section-title">

                    <span class="tag">🐶 Guia do pet</span>

                    <h2>
                        Cuidados essenciais para
                        <span>seu companheiro</span>
                    </h2>

                    <p>
                        Confira algumas dicas importantes para proporcionar
                        mais qualidade de vida ao seu animal.
                    </p>

                </div>


                <div class="care-grid">

                    <!-- IMAGEM 2 -->
                    <article class="blog-card featured">

                        <div class="card-image image-slot">

                            <img src="images/cachorro.jpg"
                                alt="Cachorro recebendo cuidados">

                            <span class="category">
                                🐶 Cachorros
                            </span>

                        </div>

                        <div class="card-content">

                            <span class="date">
                                10 de Agosto de 2026
                            </span>

                            <h3>
                                5 cuidados básicos que todo cachorro precisa
                            </h3>

                            <p>
                                Descubra hábitos simples que ajudam a manter
                                seu cachorro saudável, ativo e feliz durante
                                todas as fases da vida.
                            </p>

                            <a href="#" class="read-more">
                                Ler artigo →
                            </a>

                        </div>

                    </article>


                    <div class="care-side">

                        <article class="mini-card">

                            <div class="mini-icon">
                                💧
                            </div>

                            <div>
                                <h3>Água sempre disponível</h3>

                                <p>
                                    Mantenha água limpa e fresca ao alcance
                                    do seu pet durante todo o dia.
                                </p>
                            </div>

                        </article>


                        <article class="mini-card">

                            <div class="mini-icon">
                                🦴
                            </div>

                            <div>
                                <h3>Alimentação adequada</h3>

                                <p>
                                    Escolha alimentos adequados à idade,
                                    tamanho e necessidades do animal.
                                </p>
                            </div>

                        </article>


                        <article class="mini-card">

                            <div class="mini-icon">
                                🧼
                            </div>

                            <div>
                                <h3>Higiene</h3>

                                <p>
                                    Banhos, escovação e cuidados de higiene
                                    ajudam a prevenir diversos problemas.
                                </p>
                            </div>

                        </article>


                        <article class="mini-card">

                            <div class="mini-icon">
                                🎾
                            </div>

                            <div>
                                <h3>Brincadeiras</h3>

                                <p>
                                    Reserve um tempo para brincar e estimular
                                    fisicamente seu melhor amigo.
                                </p>
                            </div>

                        </article>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             GATOS
        ========================== -->
        <section class="cats section">

            <div class="container cats-grid">

                <!-- IMAGEM 3 -->
                <div class="cats-image image-slot">

                    <img src="images/gato.jpg"
                        alt="Gato recebendo carinho">

                    <div class="floating-card">
                        🐱 <strong>Ronronar é felicidade!</strong>
                    </div>

                </div>


                <div class="cats-content">

                    <span class="tag">
                        🐱 Para os gateiros
                    </span>

                    <h2>
                        Seu gato também merece
                        <span>todo o carinho do mundo</span>
                    </h2>

                    <p>
                        Gatos são animais independentes, mas isso não significa
                        que não precisem de atenção. Um ambiente seguro,
                        brinquedos, alimentação adequada e muito carinho são
                        essenciais.
                    </p>


                    <ul class="check-list">

                        <li>
                            <span>✓</span>
                            Ofereça brinquedos e arranhadores.
                        </li>

                        <li>
                            <span>✓</span>
                            Mantenha a caixa de areia limpa.
                        </li>

                        <li>
                            <span>✓</span>
                            Garanta água fresca diariamente.
                        </li>

                        <li>
                            <span>✓</span>
                            Faça consultas veterinárias regularmente.
                        </li>

                    </ul>

                    <a href="#contato" class="btn">
                        Quero saber mais 🐾
                    </a>

                </div>

            </div>

        </section>


        <!-- =========================
             SERVIÇOS
        ========================== -->
        <section class="services section" id="servicos">

            <div class="container">

                <div class="section-title">

                    <span class="tag">🛍️ Nosso Pet Shop</span>

                    <h2>
                        Tudo o que seu pet
                        <span>precisa em um só lugar</span>
                    </h2>

                    <p>
                        Conheça alguns dos principais serviços e produtos
                        encontrados em um Pet Shop completo.
                    </p>

                </div>


                <div class="services-grid">

                    <div class="service-card">

                        <div class="service-icon">
                            ✂️
                        </div>

                        <h3>Banho & Tosa</h3>

                        <p>
                            Cuidados de higiene para deixar seu pet limpo,
                            cheiroso e confortável.
                        </p>

                        <a href="#">Saiba mais →</a>

                    </div>


                    <div class="service-card">

                        <div class="service-icon">
                            🥩
                        </div>

                        <h3>Alimentação</h3>

                        <p>
                            Rações, petiscos e opções para diferentes fases
                            e necessidades dos animais.
                        </p>

                        <a href="#">Saiba mais →</a>

                    </div>


                    <div class="service-card">

                        <div class="service-icon">
                            🧸
                        </div>

                        <h3>Brinquedos</h3>

                        <p>
                            Opções divertidas para estimular seu pet e deixar
                            os momentos de brincadeira ainda melhores.
                        </p>

                        <a href="#">Saiba mais →</a>

                    </div>


                    <div class="service-card">

                        <div class="service-icon">
                            🏠
                        </div>

                        <h3>Acessórios</h3>

                        <p>
                            Caminhas, coleiras, potes e diversos acessórios
                            para deixar seu pet confortável.
                        </p>

                        <a href="#">Saiba mais →</a>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             IMAGEM 4 / CUIDADOS
        ========================== -->
        <section class="tips section">

            <div class="container tips-box">

                <!-- IMAGEM 4 -->
                <div class="tips-image image-slot">

                    <img src="images/cuidados.jpg"
                        alt="Cuidados e acessórios para animais">

                </div>


                <div class="tips-content">

                    <span class="tag">
                        ⭐ Conteúdo especial
                    </span>

                    <h2>
                        Pequenos cuidados,
                        <span>grandes momentos</span>
                    </h2>

                    <p>
                        Ter um animal de estimação é uma experiência cheia de
                        momentos especiais. Além de alimentação e higiene,
                        nossos pets precisam de atenção, exercícios, segurança
                        e muito carinho.
                    </p>

                    <div class="tip-numbers">

                        <div>
                            <strong>01</strong>
                            <p>
                                Mantenha uma rotina de cuidados.
                            </p>
                        </div>

                        <div>
                            <strong>02</strong>
                            <p>
                                Reserve tempo para brincar.
                            </p>
                        </div>

                        <div>
                            <strong>03</strong>
                            <p>
                                Dê muito amor e atenção.
                            </p>
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             CTA
        ========================== -->
        <section class="cta" id="contato">

            <div class="container cta-content">

                <div class="cta-paws">
                    🐾
                </div>

                <div>

                    <span class="tag light">
                        ❤️ Feito para você
                    </span>

                    <h2>
                        Porque seu pet não é
                        apenas um animal...
                    </h2>

                    <p>
                        Ele é parte da família!
                    </p>

                </div>

                <a href="mailto:contato@patasecarinho.com" class="btn btn-white">
                    Entre em contato
                </a>

            </div>

        </section>

    </main>


    <!-- =========================
         RODAPÉ
    ========================== -->
    <footer class="footer">

        <div class="container footer-grid">

            <div class="footer-brand">

                <a href="#inicio" class="logo">
                    <span class="logo-paw">🐾</span>
                    <span>Patas <strong>&</strong> Carinho</span>
                </a>

                <p>
                    Um blog criado para compartilhar informação, carinho e
                    cuidado com nossos melhores amigos.
                </p>

            </div>


            <div class="footer-links">

                <h3>Links rápidos</h3>

                <a href="#inicio">Início</a>
                <a href="#sobre">Sobre nós</a>
                <a href="#cuidados">Cuidados</a>
                <a href="#servicos">Serviços</a>

            </div>


            <div class="footer-links">

                <h3>Contato</h3>

                <p>📍 Rua dos Animais, 123</p>
                <p>📞 (11) 99999-9999</p>
                <p>📧 contato@patasecarinho.com</p>

            </div>


            <div class="footer-social">

                <h3>Siga a gente</h3>

                <div class="social-icons">

                    <a href="#" aria-label="Instagram">📸</a>
                    <a href="#" aria-label="Facebook">📘</a>
                    <a href="#" aria-label="WhatsApp">💬</a>
                    <a href="#" aria-label="TikTok">🎵</a>

                </div>

            </div>

        </div>


        <div class="footer-bottom">

            <div class="container">

                <p>
                    © 2026 Patas & Carinho — Desenvolvido com ❤️ e 🐾
                </p>

            </div>

        </div>

    </footer>

</body>

</html>